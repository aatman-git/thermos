# THERMOS Backend Configuration (.env)

# Server Port
PORT=8000

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=thermos_db

# AI / LLM Configuration (Optional - Offline Tactical Engine is enabled by default)
