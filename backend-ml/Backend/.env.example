# THERMOS backend env template. Copy to .env — never commit real keys.
DATABASE_URL=postgresql+psycopg2://thermos:thermos@postgres:5432/thermos
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
FIRMS_MAP_KEY=
FIRMS_API_KEY=
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
ENABLE_LIVE_FIRMS=false
LLM_PROVIDER=none
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini
MODEL_PATH=../ml/models/xgboost_classifier.pkl
ENCODERS_PATH=../ml/models/label_encoders.pkl
MODEL_METADATA_PATH=../ml/models/model_metadata.json
ENABLE_AI=true
ENABLE_SCHEDULER=false
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
ENABLE_OSM=true
WORLDPOP_DATA_PATH=
LANDCOVER_DATA_PATH=
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENVIRONMENT=development
