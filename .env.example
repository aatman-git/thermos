# ==============================================================================
# THERMOS — Environment Configuration (Placeholder Template)
# Copy this file to '.env' and populate with your actual secrets.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Frontend (Vite) — public deployment configuration
# Leave VITE_THERMOS_API_URL empty to use same-origin API routes in production.
VITE_THERMOS_API_URL=
# Optional raster tile template. When unset, markers use the GeoJSON layer only.
VITE_THERMOS_FIRMS_TILE_URL=

# Core Application
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string_for_jwt

# Database (PostgreSQL + PostGIS in production/docker; SQLite fallback for local demo)
DATABASE_URL=postgresql+psycopg2://thermos:thermos@localhost:5432/thermos

# In-Memory Cache & Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# NASA FIRMS API (Get free 32-char MAP_KEY from: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# (Accepts either FIRMS_MAP_KEY or FIRMS_API_KEY)
FIRMS_MAP_KEY=
FIRMS_API_KEY=
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
ENABLE_LIVE_FIRMS=false
FIRMS_POLL_INTERVAL_MIN=15
FIRMS_TIMEOUT_S=20.0

# Background Scheduler
ENABLE_SCHEDULER=false

# AI Explanation & Grounded Investigator (Google Gemini 3.6 / 2.0 Flash)
ENABLE_AI=true
GEMINI_API_KEY=your_gemini_api_key_here

# ESA WorldCover WMS Land Cover (No API key or OAuth credentials required — public WMS)
WORLDCOVER_WMS_URL=https://services.terrascope.be/wms/v2
WORLDCOVER_LAYER=WORLDCOVER_2021_MAP
WORLDCOVER_TIMEOUT_S=10.0

# OpenStreetMap & Geospatial Services
ENABLE_OSM=true
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_TIMEOUT_S=8.0
WORLDPOP_DATA_PATH=
LANDCOVER_DATA_PATH=

# ML Models & Schemas
MODEL_PATH=../ml/models/xgboost_classifier.pkl
ENCODERS_PATH=../ml/models/label_encoders.pkl
MODEL_METADATA_PATH=../ml/models/model_metadata.json

# CORS Allowed Origins (Comma-separated, never use * in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
